<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light base only: Compose owns dark/light via KalabanTheme. DayNight was
         leaking platform night colors into text fields (white-on-white).
         forceDarkAllowed=false: MIUI/HWUI force-dark was bleaching Compose text
         white after recomposition (e.g. selecting a category on the display panel). -->
    <style name="Theme.Kalaban" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#FFF7F1E8</item>
        <item name="android:colorBackground">#FFF7F1E8</item>
        <item name="android:textColorPrimary">#FF1C1917</item>
        <item name="android:textColorSecondary">#FF4A433C</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">#FF2F3E46</item>
        <item name="colorPrimaryDark">#FF2F3E46</item>
        <item name="colorAccent">#FFC17F4E</item>
    </style>
</resources>
